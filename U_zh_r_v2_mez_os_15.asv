% % % % % Очистка рабочей области
clear all
%%
close all
%%
clear Command Window display
clc
%% Установка некоторых настроек графиков по умолчанию
% Change default axes fonts.
set(groot,'DefaultAxesFontName', 'Times New Roman');
set(groot,'DefaultAxesFontSize', 14);
% Change default text fonts.
set(groot,'DefaultTextFontname', 'Times New Roman');
set(groot,'DefaultTextFontSize', 14);
set(groot,'defaultFigureColor','w');
set(groot,'defaultLineLineWidth',3);
set(groot,'defaultAxesXGrid','on');
set(groot,'defaultAxesYGrid','on');
set(groot,'defaultFigurePosition', [0, 0, 1500, 1500]);

%% Добавление пути к папке с функциями
%%Не трогайте это
%%%%Определение пути по которому рассположен файл
way = fileparts(which(mfilename));

%%%% Путь к папкам с файлами функций
way2func = way + "\Function_folder";

%%% Добавления пути к функциям ну на всякий случай
addpath(way2func);

%%%% Путь к папкам с файлами функций
way2func = way + "\Force_spectr";

%%%%% Создание файла с основными параметрами полученными в результате
%%%%% расчётов
fileID_full = fopen('file_full.txt','w');
fprintf(fileID_full,'\n В этом файле основные параметры полученные в результате расчёта\n');

%%% Добавления пути к функциям ну на всякий случай
addpath(way2func);
global A c_x ro J_dv n_0 J_kol r0 g f k_f
%% Стандартные постоянные величины
% % % % %  Ускорение свободного падения
g = 9.80665;
% % % % % Плотность воздуха
ro = 1.225;

%%%%%%% Коэффициент сцепления с асфальтом
fi_asfalt = 0.8;

%%%%%%% Коэффициент сцепления с грунтом
fi_grunt = 0.5;

% % % % %   Коэффициент сопротивления качению
f               =   0.015;

% % % % % скорости автомобиля
k_f             =   3.9e-4;

asim = 0;
% % % % %  Коэффициент вычисления средней скорости
koef_srednei_skorosti = 0.65;

%%%%%%% Полная масса автомобиля
m_avt = 32e3;
m_priz = 0e3;
fprintf(fileID_full,'\n Полная масса автомобиля \t %.4f', m_avt);
fprintf(fileID_full,'\n Масса прицепа \t %.4f', m_priz);
%%%%%%% Масса на задней оси автомобиля
m_os = 11.5e3;
fprintf(fileID_full,'\n Сцепная масса ведущей оси \t %.4f',2*m_os);
% % % % %   Площадь лобовой проекции автомобиля
A               =   0.8 * 3.65  * 2.05;
% % % % %   Коэффициент аэродинамического сопротивления 
c_x             =   0.6;
% % % % %   (взят для двигателя аналогичной мощности)
J_dv            =   7;
% % % % %   Момент инерции колеса
J_kol           =   20;
% % % % %  Число колёс автомобиля
n_0             =   10;
fprintf(fileID_full,'\n Площадь лобовой проекции \t %.4f',A);

% % % % %  Коэффициент затрачиваемой удельной силы на разгон
k_a = 0.2;
% % % % %  Удельная сила тяги обусловленная сопротивлением дороги
p_psi = 0.025;
% % % % %  Коэффициент формы
sigma_lgp_real = 0.25;
% % % % %  Доля крутящего момента передаваемого валом
lambda = m_os/m_avt;
% % % % %  Коэффициент учитывающий увеличение крут момента из-за циркул
tetta = 1;
% % % % %  КПД трансмиссии до агрегата
kpd_before =1;
% % % % %  Коэффициент динамичности
k_din = 1.5;
%%%%%%% Коэффициент блокировки межосевого дифференциал
K_b_mkdiff = 1;
%%%%%%% Коэффициент блокировки колёсного диффференциала
K_b_modiff = 1;

%%%%%% Определение передаточного числа главной передачи
DVS_VSH = [
601.1223613316328, 1274.9899789166811
611.8212342851193, 1298.8573362138522
643.925141206174, 1364.4811161144225
667.9976053515188, 1418.1826700330562
689.3880631978968, 1471.8956766183396
705.0934565660871, 1533.3217969543061
745.5498581431063, 1603.1775944194274
780.2774668783675, 1716.616257580884
806.9882089591088, 1806.1761107785205
830.9586402561233, 1943.5737525703428
844.2593508420313, 2033.1908691012254
854.8926312501626, 2110.8628543168743
870.8826361956324, 2194.490226190166
889.5765116218538, 2260.1712694239827
918.7349561740284, 2283.182493554388
953.2299631204612, 2296.154340137692
1002.1770478148833, 2295.5600093703633
1054.9823338075453, 2293.354416651483
1096.0472682787163, 2295.159166037637
1144.323381660116, 2294.9530180379497
1174.580896862555, 2296.0439851945
1209.7884855963196, 2295.0587874407843
1265.9691839486973, 2294.8188853903666
1313.4115106959339, 2293.9205854904685
1340.877508727778, 2293.9026880359133
1393.314413319256, 2292.377700283388
1438.779536319513, 2249.2075080546892
1475.8300453348277, 2195.827302652984
1511.4690397481959, 2148.192751358784
1558.3623317076185, 2085.615573715154
1614.6337037826336, 2010.9973123243055
1667.1583081043884, 1937.5334886791038
1723.4306054214712, 1862.156264437843
1775.951971395989, 1791.3488107690855
1822.5622962433954, 1741.4379680824313
1855.2456792212188, 1704.3262632735195
1894.110356620829, 1644.0805752646802
1935.425306326297, 1548.9394204365026
1973.0139592592532, 1438.1606502885938
2012.4837835229098, 1320.4167239435565
2050.076111722968, 1206.6231846953979
2087.6627856659466, 1097.4677517553164
2097.936958275853, 1059.3591712433954
];

figure;
subplot(2, 1, 1);
hold on;
xlabel({'Частота вращения колвенчатого вала, рад/с','а)'});  
ylabel([{'Мощность', 'N, кВт'}])
plot(DVS_VSH(:,1), DVS_VSH(:,2).* DVS_VSH(:,1)/1e3 / 60 * 2*pi , 'LineWidth', 3);

subplot(2, 1, 2);
hold on;
xlabel({'Частота вращения колвенчатого вала, рад/с','б)'});  
ylabel({'Крутящий момент' 'M, Н \cdot м'})
plot(DVS_VSH(:,1), DVS_VSH(:,2), 'LineWidth', 3);
saveas(gcf, 'Характеристика двигателя D13K460', 'png');

% % % % %   Коэффициент использования двигателя
k_ch_dvs        =   0.9;
%%% Частота вращения двигателя
w = DVS_VSH(:,1);
%%% Частота вращения соответстующая минимуму удельного расхода
w_ge_min = 1300*pi/30;

%%%%% Определение максимлаьного момента по ВСХ
[M_max,Number_M_max] = max(DVS_VSH(:,2));
W_M_max = DVS_VSH(Number_M_max,1)*pi/30;
fprintf(fileID_full,'\n Частота вращения соответствующая максимлаьному моменту \t %.4f', W_M_max);

%%%%% Определение максимальной мощности по ВСХ
[N_max,Number_N_max] = max(DVS_VSH(:,2).*DVS_VSH(:,1));
W_N_max = DVS_VSH(Number_N_max,1)*pi/30;
fprintf(fileID_full,'\n Частота вращения соответствующая максимальной мощности \t %.4f',W_N_max);

%%%%%% Максимальная скорость движения автомобиля в км/ч
V_max = 90;
V_min = 5;
fprintf(fileID_full,'\n Максимальная скорости \t %.4f',V_max);
fprintf(fileID_full,'\n Минимальная скорость \t %.4f',V_min);

%%%%%% Перевод в СИ
V_max = V_max/3.6;
V_min = V_min/3.6;

% % % % %   Маркировка 315/80 R22.5
SH_1            =   315;
SH_2            =   80;
SH_R            =   22.5;
% % % % %   Расчёт статического радиуса колеса
r0              =   ((SH_1   *   SH_2/100)      +     ...
((25.4       *       SH_R)    /   2))   /   1000;
fprintf(fileID_full,'\n Радиус свободный колеса \t %.4f',r0);
%%%% Передаточные числа КП
u_kp = [13.51
        10.83
        8.92
        7.15
        5.74
        4.60
        3.75
        3
        2.38
        1.91
        1.53
        1.23
        1
        0.8
        ];
fprintf(fileID_full,'\n Передаточные числа коробки \t %.4f', u_kp);
 % % % %  Передаточное отношение раздаточной коробки
u_rk = [1];   
% % % % %  КПД трансмиссии
kpd_kp = 0.96;
kpd_rk = 1;
kpd_gp = 0.95;
kpd_tr = kpd_kp*kpd_rk*kpd_gp;

%%%%% Определение передаточного числа главной передачи
%%%%% из условия движения на макс скорости при минимуме расхода
u_gp = w_ge_min * r0 / min(u_kp(u_kp>=1)) / V_max;

%%% Проверка условия движения автообиля
% % % % % Вычисление минимального передаточного числа 
% % % % % исходя из максимальной скоростью
u_tr_min = W_N_max * r0 / V_max
u_gp_max = u_tr_min / min(u_kp(u_kp>=1))

% % % % %   Вычисление максимального передаточного числа по критерию
% % % % %   минимальной устойчивой скорости
u_tr_max_min_speed = W_M_max * r0 / V_min;
u_gp_min = u_tr_max_min_speed / max(u_kp(u_kp>=1))
% % % % %   Вычисление максимального передаточного числа по критерию
% % % % %   максимального реализуемого сцепления
u_tr_max_clutch         = 2 *  m_os * g  *   r0          *   fi_asfalt  /...
                           (M_max   *   k_ch_dvs    *   kpd_tr)   ;
%%
% % % % %   максимального преодолеваемого сопротивления
u_tr_max_psi            =   (Soprotivlenie(alpha,V_min, m_avt)/   m*g  *...
                            r0      *   P_z_ved)    /   (M_max  *...
                            k_ch_dvs    *   h_tr    ); 
    %%                   
if u_tr_max_min_speed > u_tr_max_clutch
    u_gp_min = u_tr_max_min_speed / max(u_kp(u_kp>=1));
end
u_tr = u_kp * u_rk * u_gp;  
fprintf(fileID_full,'\n Передаточное отношение главной пары \t %.4f', u_gp);
if u_gp < u_gp_min
 fprintf(fileID_full,['\n Передаточное отношение главной пары слишком мало\n' ...
     ' не проходит по сцеплению или по минимальной скорости']);
else 
 fprintf(fileID_full,'\n Передаточное отношение главной пары достаточно велико');
end

if u_gp > u_gp_max
 fprintf(fileID_full,'\n U_gp не обеспечивает максимальную скорость\n');
else 
 fprintf(fileID_full,'\n Передаточное отношение главной пары достаточно мало');
end

% % % % %  Передаточное число трансмиссии до агрегата
u_before = u_gp;

%%%%%% Максимальный угол подъёма автомобиля в градусах
alpha = 30;
alpha_degree = atan(alpha/100)*180/pi;
alpha = atan(alpha/100);
fprintf(fileID_full,'\n Максимальный угол подъёма \t %.4f', alpha_degree);
clear alpha_degree

%%%%%% Массив расстояний между осями
L = [0, 3300, 4700];
L = L/1000;
fprintf(fileID_full,'\n Положение осей \t %.4f', L);

%%%%%% Положение центра масс 
CM_polozenir = (L(1,2)+L(1,3))/2*m_os*2/m_avt;
CM_y = 1.8;
fprintf(fileID_full,'\n Высота положение центра масс \t %.4f', CM_y);

% % % % %  Требуемый ресурс автомобиля в киллометрах
L_0 = 1/2*10^6;

%%%%%% Положение в системе координат ЦМ
L_cm = L - CM_polozenir;

%%%%%% Определение положения сближенных осей
if length(L)>2
    L_23 = (L(1,2) + L(1,3))/2;
end   

%%%%% Частота колебаний автомобиля, Гц
f_ch = 1.5;
%%%%% Осевая скорость движения кулачковой муфты
V_os = 0.15;

%% Построение Дин фактрор и ускорение
%%% Инерционные массы все дела
delta = delta_f(u_tr', kpd_tr, m_avt);
%%% Графики дин фактора
DVS_VSH(:,1) =DVS_VSH(:,1)*  pi/30; 
[accel, Din_f, v] = ...
Din_f_und_accel(u_tr', kpd_tr, k_ch_dvs, delta, DVS_VSH, m_avt, 'Trash');

DVS_VSH(:,1) =DVS_VSH(:,1) * 30/pi;

%% Часть с определением диаметра полуоси

%%%%%% Материал полуоси
mark_steel = "30ХГС";

%%%%%% Предел прочности
sigma_v = 1080;
fprintf(fileID_full,'\n Предел прочности полуоси \t %.4f', sigma_v);
%%%%%% Предел текучести
sigma_t = 850;
fprintf(fileID_full,'\n Предел текучести полуости \t %.4f', sigma_t);
%%%%%% Коэффициент запаса прочности
S = 1.2;
%%%%%% Жёсткость подвески по частоте
C_x = Zeskost_chastota(m_avt, f_ch);

%%%%%% Определение предела выносливости
tau_endurance = (0.6 * sigma_v*10^6);
tau_endurance = 800e6;
fprintf(fileID_full,'\n Предел выносливости по кручению \t %.4f', tau_endurance);
%%%%%% Реакции по осям для полного контакта
Rz_massiv = Rz_zhestkost(m_avt * g * cos(alpha), m_avt * g * sin(alpha),...
    L , C_x, CM_polozenir, CM_y);

%%%%%% Реакции по осям для вывешенной оси
L_13 = L;
L_13(2) = [];
Rz_massiv_13 = Rz_zhestkost(m_avt * g * cos(alpha), m_avt * g * sin(alpha),...
    L_13 , C_x, CM_polozenir, CM_y);

%%%%%% Максимальный момент по двигателю при вывешивании колеса
%%%%%% Блокировка межколёсного дифференциала 
%%%%%% Делим на 2 тк вторая ось по прежнему работает
T_k_kol = M_max * u_gp * max(u_kp) /2;
%%%%%% Максимальный момент по двигателю при вывешивании оси
%%%%%% Блокировка межосевого дифференциала
%%%%%% Не делим на 2 тк вторая ось вывешена
T_k_os = M_max* u_gp * max(u_kp);

%%%%%% Максимальный момент по сцеплению на грунте
T_scepl_grunt = max(Rz_massiv_13) * fi_grunt *r0;
%%%%%% Максимальный момент по сцеплению на асфальте
%%%%%% Делю на 2 тк масса на 2м колесе осталась
T_scepl_asfalt = max(Rz_massiv)/2 * fi_asfalt * r0;

%%%%% Максимальный крутящий момент передаваемый проходным валом
T_prohod = M_max * max(u_kp);
T_scepl_grunt = max(Rz_massiv_13) * fi_grunt * r0 /u_gp;
T_prohod_max = min(T_scepl_grunt, T_prohod);

%%%%% Расчёт приблизительного диаметра проходного вала по крутящему моменту
d_prohod = ceil( ( (T_prohod_max /0.2 /  tau_endurance)^(1/3)*1000)/0.5)*0.5;

%%%%% Выбор максимального момента по минимумам
%%%%% Одно колесо на льду второе на асфальте
T_kol_max  =    min(T_k_kol, T_scepl_asfalt);

%%%%% Одна ось на земле вторая в яме
T_os_max   =    min(T_k_os,  T_scepl_grunt);

%%%%% Наибольший момент по ситуации (приведённый к колесу)
%%%%% Тут делим на 2 тк сравниваем приведённое к полуоси
T_poluos_max    =    max(T_kol_max, T_os_max/2);

%%%%% Расчёт приблизительного диаметра полуочи по крутящему моменту
d_poluos = ceil( ( (T_poluos_max /0.2 / tau_endurance )^(1/3)*1000)/0.5)*0.5;

fprintf(fileID_full,'\n Максимальный крутящий момент на полуоси \t %.4f', T_poluos_max);
fprintf(fileID_full,'\n Максимальный крутящий момент на шестерне \t %.4f', T_prohod_max );
fprintf(fileID_full,'\n Диаметр полуоси \t %.4f', d_poluos);
fprintf(fileID_full,'\n Диаметр проходного вала \t %.4f', d_prohod);


%%%%% Требуемое гипоидное смещение передачи для автомобиля
Gipoid_sm = (d_prohod + d_poluos)/2 + 2;
fprintf(fileID_full,'\n Величина гипоидного смещения \t %.4f', Gipoid_sm);
% %%%%% Желательный размер ведомой шестерни для реализации смещения
% if Gipoid_sm < 57 
%     k_hyp = 0.12
% else
%     k_hyp = 0.125
% end
k_hyp = 0.125;
D_shesternia = Gipoid_sm / k_hyp;
D_shesternia = round(D_shesternia,0)
fprintf(fileID_full,'\n Делительный диаметр ведомого колеса \t %.4f', D_shesternia);

T_max_nu = min(2*m_os*g*fi_asfalt * r0 / u_gp,T_k_os)
fprintf(fileID_full,'\n Максимальный момент действующий на межосевой дифференциал \t %.4f', T_max_nu);
%% Входные параметры для межосевого дифференциала
%%% Число зубьев полуосевой шестерни
Z_sun = 16;
%%% Исходное передаточное отношение 
U_dif_0 = 1.5;

%%% Число саттелитов
N_sut = 4;

Mezos_dif = Differential_paramet_func( Z_sun, ...
    U_dif_0, N_sut, T_max_nu,1, 1, 'Mezos_diff.txt',6.8);

%%%% Определение диаметра шипа крестовины и рассположения его и шайбы
[Mezos_kest(1,1),Mezos_kest(1,2)]...
    = krestovina_param_func(...
    Mezos_dif{25,1},...       %%% Число саттелитов
    Mezos_dif{4,1}*Mezos_dif{1,2}/2,...          %%% Точка прилложения силы в зацепления
    M_max*max(u_kp),...       %%% Максимальный момент на корпусе диф
    1,...         %%% Тип автомобиля
    Mezos_dif{8,1},...        %%% Угол делительного конуса
    Mezos_dif{10,1},...            %%% Ширина зубчатого зацепления
    Mezos_dif{24,1},...           %%% Внешнее конусное расстояние
    Mezos_dif{2,1},...     %%% Угол контакта в зацеплении
    Mezos_dif{15,2},...      %%% Делительный диаметр внешний
    Mezos_dif{13,1},...         %%% высота ножки зуба средня
    Mezos_dif{4,1}*Mezos_dif{1,1});           %%% Делительный диаметр внешний

fprintf(fileID_full,'\n Число саттелитов межосевого дифференциала\t %.4f', Mezos_dif{25,1});
fprintf(fileID_full,['\n Число зубьев солнца и саттелита мехосевого дифференциала' ...
    ' \t %.4f,%.4f'], Mezos_dif{1,1}, Mezos_dif{1,2});
fprintf(fileID_full,'\n Модуль торцевой межосевого диф \t %.4f', Mezos_dif{4,1}*1000);

%% Кулачковая муфта блокировки межколёсного дифференциала
koef_neravn = 3;

d_up = 250e-3;
d_hole = 190e-3;

h = 11e-3;
z_kul = 13;

pover = 0;

Zapas = 3;
sigma_t = 850e6;
d_spline = 160e-3;
delta = 0* pi/180;
f = 0.1;

Name = 'Kulak_mezos.txt';
[Q] = Kulak_muft_func(T_prohod_max,...     % Максимальный крутящий момент действующий в передаче
    z_kul,...                           % Число зубьев кулачковой муфты
    h,...                               % Торцевая высота кулачка
    d_up,...                            % Максимальный наружный диаметр муфты
    d_hole,...                          % Минимальный внутренний диаметр муфты
    d_spline,...                        % Средний диаметр шлицевого соединения
    sigma_t,...                         % предел текучети материала
    Zapas,...                          % Коэффициент запаса
    delta,...                           % Угол профиля кулачка
    f,...                               % Коэффициент трения между кулачкамы
    V_os,...                            % Осевая скорость движения муфты
    Name,...                           % Имя файла для записи результатов расчёта
    pover...                           % Включение поверочнога расчёта или проектировочного
    );

%% Входные параметры для межколёсного дифференциала
%%% Число зубьев полуосевой шестерни
Z_sun = 16;
%%% Исходное передаточное отношение 
U_dif_0 = 1.5;
%%% Число саттелитов
N_sut = 4;

% % 
Mezkol_dif = Differential_paramet_func( Z_sun, ...
    U_dif_0, N_sut, T_prohod_max*u_gp, 1, 1, 'Mekol_diff.txt',6);

%%%% Определение диаметра шипа крестовины и рассположения его и шайбы
[Mezkol_kest(1,1), Mezkol_kest(1,2)]...
    = krestovina_param_func(...
    Mezkol_dif{25,1},...                        %%% Число саттелитов
    Mezkol_dif{4,1}*Mezkol_dif{1,2}/2,...        %%% Точка прилложения силы в зацепления
    M_max*max(u_kp),...                       %%% Максимальный момент на корпусе диф
    1,...                                       %%% Тип автомобиля
    Mezkol_dif{8,1},...                          %%% Угол делительного конуса
    Mezkol_dif{10,1},...                         %%% Ширина зубчатого зацепления
    Mezkol_dif{24,1},...                        %%% Внешнее конусное расстояние
    Mezkol_dif{2,1},...                         %%% Угол контакта в зацеплении
    Mezkol_dif{15,2},...                        %%% Делительный диаметр внешний
    Mezkol_dif{13,1},...                        %%% высота ножки зуба средня
    Mezkol_dif{4,1}*Mezkol_dif{1,1});           %%% Делительный диаметр внешний

fprintf(fileID_full,'\n Максимальный момент действующий на межосевой дифференциал \t %.4f', T_prohod_max*u_gp);
fprintf(fileID_full,'\n Число саттелитов межосевого дифференциала\t %.4f', Mezkol_dif{25,1});
fprintf(fileID_full,['\n Число зубьев солнца и саттелита мехосевого дифференциала' ...
    ' \t %.4f,%.4f'], Mezkol_dif{1,1}, Mezkol_dif{1,2});
fprintf(fileID_full,'\n Модуль торцевой межосевого диф \t %.4f', Mezkol_dif{4,1}*1000);

%% Кулачковая муфта блокировки межколёсного дифференциала
koef_neravn = 2;

d_up = 105e-3;
d_hole = 70e-3;

h = 9e-3;
z_kul = 9;

pover = 0;

Zapas = 1.5;
sigma_t = 800e6;
d_spline = 65e-3;
delta = 5* pi/180;
f = 0.1;

Name = 'Kulak_mezkol.txt';
[Q] = Kulak_muft_func(T_poluos_max,...     % Максимальный крутящий момент действующий в передаче
    z_kul,...                           % Число зубьев кулачковой муфты
    h,...                               % Торцевая высота кулачка
    d_up,...                            % Максимальный наружный диаметр муфты
    d_hole,...                          % Минимальный внутренний диаметр муфты
    d_spline,...                        % Средний диаметр шлицевого соединения
    sigma_t,...                         % предел текучети материала
    Zapas,...                          % Коэффициент запаса
    delta,...                           % Угол профиля кулачка
    f,...                               % Коэффициент трения между кулачкамы
    V_os,...                            % Осевая скорость движения муфты
    Name,...                           % Имя файла для записи результатов расчёта
    pover...                           % Включение поверочнога расчёта или проектировочного
    );
type 'Kulak.txt'


%%%%%% Определение параметров гипоидной передачи

% % % %% Определение первичных параметров для расчёта гипоида геометрического
% % % %%% Internal Data
%%%% Число зубьев шестерни и колеса
u = u_gp;
[n_sh, N_kol, u] = teeth_u_function(u, 9, 27);
%% Тип автомобиля
type = 'g';
%%%%
betta_1 = zeros(length(u),1);
hypoid_ex = Gipoid_sm/1e3;
D_e2 = D_shesternia/1e3;
%% Определение радиуса резцовой головки по диапазону диаметров
r_c = r_c_d_e_func(D_e2);
% % % u = 1
% % % pogr = 1e-3;
% % % N_kol = 41;
% % % n_sh = 10;
% % % 
% % % F = 31.75e-3;
% % % hypoid_ex = 38.1e-3;
% % % D_e2 = 209.55e-3;
% % % r_c = 114.3e-3;
% % % betta_1 = 50*pi/180;
% % % type = 'l';
delete_all_files_in_folder("Hypoid_setrakov_funktion_variant")
for i = 1:length(u)
n_sh_i = n_sh(1,i);
N_kol_i = N_kol(1,i);
u_i = u(i);

%%%% Угол ведущего колеса согласно 3т т.2стр416
betta_1(i,1) = (25 + 5*(u_i)^(1/2) + 90 * hypoid_ex/D_e2) * pi/180;

% % % degrees2dms(betta_1*180/pi)
%%% Приблизительное определение ширины колеса
m_te = D_e2 / N_kol_i;
Re = m_te * (n_sh_i^2 + N_kol_i^2)^(1/2)/2;
%%%% Ширина ЗК
F = min(ceil(Re * 0.3*1000)/1000, ceil(10*D_e2/N_kol_i*1000)/1000);

Hypoid_setrakov_funktion(...
    N_kol_i,...       %%%% Число зубьев колеса
    n_sh_i,...        %%%% Число зубьев шестерня
    F,...           %%%% Ширина ширина
    hypoid_ex,...   %%%% Гипоидное смещение
    D_e2,...        %%%% Внешний делительный диаметр
    r_c,...         %%%% Радиус резцовой головки 
    type,...        %%%% Тип автомобиля 'l'/'g' (влияет на угол зацепления)
    betta_1(i,1),...   %%%% Желаемый угол наклона шестерни
    1e-3);          %%%% Требования степени сходимости для итерационной части  
end

%% Часть с определением относительных пробегов и нагрузок на них

  %% Расчётная часть

% % % % %  Тк в определённый помент происходит дозапись последнего элементв
% % % % %  это запускать только полностью
% % % % %  Получение передач трансмиссии (т.е. режимы работы по трансмис)
 u_tr = u_kp * u_rk* u_gp;

[hour, T_r_max, n_r_max] = Spectr_nagr(...
    L_0,...                     %%%% Суммарный пробег в км
    u_tr,...                    %%%% Передаточные числа в трансмисии
    u_kp,...                    %%%% Передаточные числа в КП
    u_rk,...                    %%%% Передаточные числа в РК      
    u_before,...                %%%% Передаточные числа от колёс до агрегата
    kpd_before ,...             %%%% КПД от колёс до агрегата
    kpd_tr,...                  %%%% Общий кпд в трансмиссии
    V_max,...                   %%%% Максимальная скорость
    V_min,...
    r0,...                      %%%% Статический радиус колеса (можно и более точные)
    m_avt,...                   %%%% Полная масса автомобиля
    m_priz,...                  %%%% Масса прицепа
    2*m_os,...                    %%%% Масса на ведущих осях суммарная
    fi_asfalt,...                 %%%% Коэфиициент сцепления для опорной поверхности
    koef_srednei_skorosti,...   %%%% Отношение средней скорости к максимлаьной (0,6...0,65)
    M_max,...                   %%%% Максимальный крутящий момент на двигателе
    asim,...                    %%%% Если распределени нормальное 1
    c_x,...                     %%%% Коэффициент обтекаемости
    A,...                       %%%% Площадь лобовой проекции автомобиля
    p_psi,...                   %%%% Удельная сила тяги обусловленная сопротивлением дороги
    k_din,...                   %%%% Коэффициент динамичности
    tetta,...                   %%%% Коэффициент учитывающий увеличение крут момента из-за циркул
     k_a,...                    %%%% Коэффициент затрачиваемой удельной силы на разгон
    lambda,...                  %%%% Доля крутящего момента передаваемого валом
    sigma_lgp_real...          %%%% Коэффициент формы
    )
fprintf(fileID_full,'\n Часы пробега агрегата для заданного ресурса\t %.4f', hour);
fprintf(fileID_full,'\n Максимальный крутящий момент на валу шестерни\t %.4f', T_r_max);
fprintf(fileID_full,'\n Максимальная чатоста вращения шестерни\t %.4f', n_r_max);



fclose(fileID_full);

close all

